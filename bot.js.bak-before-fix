async function sync(client, db, force = false) {
  const s = db.settings, st = stOf(db.id);
  const guildId = String(s.guildId || '').trim();
  if (guildId && !/^\d{15,25}$/.test(guildId))
    throw new Error('Guild ID inválido: use somente os números do ID do servidor (sem espaços, #, <>).');

  const seen = new Set();
  const body = [...db.commands.filter(c => c.enabled !== false).map(toSlash), ...modSlash(db)]
    .filter(c => c.name && !seen.has(c.name) && seen.add(c.name)).slice(0, 100);

  const key = JSON.stringify([guildId, body]);
  if (!force && st.hash === key) return;    // same commands already registered: do not spend Discord's command-registration limit

  const rest = new REST({ timeout: 15000, rejectOnRateLimit: e => e.timeToReset > 15000 }).setToken(s.token);
  const appId = client.user.id;
  const globalRoute = Routes.applicationCommands(appId);

  if (guildId) {
    if (!client.guilds.cache.has(guildId))
      throw new Error(`O bot NÃO está no servidor ${guildId}. Convide-o (escopos bot + applications.commands) ou corrija o Guild ID. Servidores onde ele está: ${[...client.guilds.cache.values()].map(g => `${g.name} (${g.id})`).join(', ') || 'nenhum'}.`);
    await rest.put(Routes.applicationGuildCommands(appId, guildId), { body });
    console.log(`[sync ${db.name}] ${body.length} comandos enviados ao servidor ${guildId}`);
    // avoid duplicated commands: clear the global ones once
    if (!st.clearedGlobal) { await rest.put(globalRoute, { body: [] }).catch(() => {}); st.clearedGlobal = true; }
    if (s.lastGuild !== guildId) { s.lastGuild = guildId; saver(); }
  } else {
    // back to global: clear the commands of the server used before
    if (s.lastGuild) {
      await rest.put(Routes.applicationGuildCommands(appId, s.lastGuild), { body: [] }).catch(() => {});
      s.lastGuild = ''; saver();
    }
    await rest.put(globalRoute, { body });
    st.clearedGlobal = false;
    console.log(`[sync ${db.name}] ${body.length} comandos enviados (global)`);
  }
  st.hash = key;
}

