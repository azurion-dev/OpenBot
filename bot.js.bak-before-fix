    if (++i.steps > 3000) throw new Error('Too many steps (possible infinite loop)');
    const n = nodes.get(cur); if (!n) break;
    if (n.type === 'loop') {
      const d = n.data || {}, items = loopItems(i, d), prev = i.loop, delay = Math.min(Math.max(Number(d.delay) || 0, 0), 10);
      i.inLoop = (i.inLoop || 0) + 1;
      let out;
      for (let k = 0; k < items.length; k++) {
        i.loop = { index: k + 1, count: items.length, item: items[k] };
        const r = await walk(i, c, n.next);
        if (r === 'stop') { out = 'stop'; break; }
        if (r === 'break') break;
        if (delay && k < items.length - 1) await sleep(delay * 1000);
      }
      i.inLoop--; i.loop = prev;
      if (out) return out;
      cur = n.else; continue;
    }
    let r;
    try { r = await exec[n.type]?.(i, n.data || {}, c, n); }
    catch (e) { throw PERM_NODES.has(n.type) ? permError(i, n, e) : e; }      // blocks that need Discord permissions: friendly / custom message
    if (r === 'stop' || r === 'break' || r === 'skip') return r;
    cur = r === 'else' ? n.else : n.next;
  }
}

async function runGraph(i, c, from) {
  i.vars ||= {}; i.steps = 0;
  try {
    const r = await walk(i, c, from);
    if (r === 'stop' || r === 'break') return;
  } catch (e) {
    console.error(i.ev ? `[event "${c.name}"]` : `[command /${c.name}]`, e.cause?.message || e.message);
    if (!i.ev || e.custom) await send(i, { content: e.custom ? e.message : '❌ ' + e.message, ephemeral: true }).catch(() => {});
    return;
  }
  if (!i.ev && !i.replied && !i.deferred) await i.reply({ content: '✅ Done!', ephemeral: true }).catch(() => {});
}

const OFF = 'Command disabled';
const isOff = c => !!c && c.enabled === false;
async function onInt(i) {
  const db = i.client.db;
  try {
    if (i.isChatInputCommand()) {
      const c = db.commands.find(x => x.name === i.commandName);
      if (!c) return;
      if (isOff(c)) return void i.reply({ content: OFF, ephemeral: true });
      if (c.guildOnly && !i.guild) return void i.reply({ content: 'This only works in servers.', ephemeral: true });
      const blocked = gate(i, c);
      if (blocked) return void i.reply({ content: blocked, ephemeral: true });
      await runGraph(i, c, c.start?.next);
    } else if (i.isModalSubmit() && i.customId.startsWith('m:')) {
      const [, cid, bid] = i.customId.split(':');
      const c = db.commands.find(x => x.id === cid); if (!c) return;
      if (isOff(c)) return void i.reply({ content: OFF, ephemeral: true });
      const s = i.client.ctx?.get(`${i.user.id}:${cid}`);
      if (s) { i.options = s.options; i.vars = { ...s.vars }; }
      await runGraph(i, c, c.nodes.find(x => x.id === bid)?.next);
    } else if ((i.isButton() || i.isAnySelectMenu()) && i.customId.startsWith('x:')) {
      const [, cid, bid, xid] = i.customId.split(':');
      const c = findCmd(db, cid);
      const it = findItem(c?.nodes.find(x => x.id === bid)?.data?.msg, xid);
      if (!it) return;
      if (isOff(c)) return void i.reply({ content: OFF, ephemeral: true });
      let resp = it.value, specific = it.value, picked = it.label || '', ids = [xid];
      if (i.isAnySelectMenu()) {
        let texts;
        if (i.isStringSelectMenu()) { const o = it.options || []; texts = i.values.map(v => o[+v]?.label); resp = o[+i.values[0]]?.resp || it.response; specific = o[+i.values[0]]?.resp; ids = [...i.values.map(v => `${xid}#${v}`), xid]; }
        else { resp = it.response; specific = ''; texts = i.values.map(v => i.isUserSelectMenu() ? `<@${v}>` : i.isRoleSelectMenu() ? `<@&${v}>` : i.isChannelSelectMenu() ? `<#${v}>` : (i.roles?.has(v) ? `<@&${v}>` : `<@${v}>`)); }
        i.selectedText = texts.join(', '); picked = i.selectedText;
      }
      const s = ctxFor(i, cid);
      if (s) { i.options = s.options; i.vars = { ...s.vars }; i.evMap = s.evMap; }
      i.pressed = { label: picked, id: xid };
      const trig = trigFor(c, ids);
      if (trig) {
        if (specific) await i.reply({ content: fill(specific, i), ephemeral: true });
        await runGraph(i, c, trig.next);
      } else await i.reply({ content: fill(resp || (i.isAnySelectMenu() ? '✅ {selected}' : '✅'), i), ephemeral: true });
    } else if (i.isButton() && i.customId.startsWith('b:')) {
      const [, cid, bid, n] = i.customId.split(':');
      const oc = db.commands.find(x => x.id === cid);
      if (isOff(oc)) return void i.reply({ content: OFF, ephemeral: true });
      const d = oc?.nodes.find(x => x.id === bid)?.data || {};
      await i.reply({ content: fill(d[`b${n}v`], i) || '✅', ephemeral: true });
    } else if (i.isAnySelectMenu() && i.customId.startsWith('s:')) {
      const [, cid, bid] = i.customId.split(':');
      const oc = db.commands.find(x => x.id === cid), d = oc?.nodes.find(x => x.id === bid)?.data; if (!d) return;
      if (isOff(oc)) return void i.reply({ content: OFF, ephemeral: true });
      let resp = d.response, texts;
      if (i.isStringSelectMenu()) { const o = selOpts(d); texts = i.values.map(v => o[+v]?.label); resp = o[+i.values[0]]?.resp || d.response; }
      else texts = i.values.map(v => i.isUserSelectMenu() ? `<@${v}>` : i.isRoleSelectMenu() ? `<@&${v}>` : i.isChannelSelectMenu() ? `<#${v}>` : (i.roles?.has(v) ? `<@&${v}>` : `<@${v}>`));
      i.selectedText = texts.join(', ');
      await i.reply({ content: fill(resp || '✅ {selected}', i), ephemeral: !!d.ephemeral });
    }
  } catch (e) { console.error(e); }
}


// ---------------------------------------------------------------------------
// Events: every Discord event below can be used as a trigger in the dashboard
// ---------------------------------------------------------------------------
const SELF = ['message_create', 'message_edit', 'reaction_add', 'reaction_remove'];   // never react to the bot itself (avoids loops)
const ids = s => String(s || '').match(/\d{15,}/g) || [];
const mem = (u, m, g) => !u ? {} : ({
  member: `<@${u.id}>`, 'member.name': u.username, 'member.id': u.id, 'member.tag': u.tag, 'member.avatar': u.displayAvatarURL({ size: 256 }),
  'member.nickname': m?.nickname || u.username, 'member.created': unix(u.createdTimestamp), 'member.joined': unix(m?.joinedTimestamp), 'member.count': g?.memberCount ?? ''
});
const msg = m => ({
  'message.id': m.id, 'message.content': m.content ?? '', 'message.url': m.url ?? '',
  'message.author': m.author ? `<@${m.author.id}>` : '', 'message.author.name': m.author?.username ?? '', 'message.author.id': m.author?.id ?? '',
  'message.channel': `<#${m.channelId}>`, 'message.channel.id': m.channelId, 'message.channel.name': m.channel?.name ?? '',
  'message.attachments': m.attachments?.size ?? 0, 'message.attachment': m.attachments?.first?.()?.url ?? ''
});
const chn = ch => ({ 'channel.id': ch.id, 'channel.name': ch.name ?? '', 'channel.type': ChannelType[ch.type] ?? '', 'channel.category': ch.parent?.name ?? '', 'channel.topic': ch.topic ?? '' });
const rol = r => ({ role: `<@&${r.id}>`, 'role.id': r.id, 'role.name': r.name, 'role.color': r.hexColor });
const thr = t => ({ thread: `<#${t.id}>`, 'thread.id': t.id, 'thread.name': t.name, 'thread.parent': t.parentId ? `<#${t.parentId}>` : '', 'thread.parent.id': t.parentId ?? '', 'thread.owner': t.ownerId ? `<@${t.ownerId}>` : '' });
const inv = i => ({ 'invite.code': i.code, 'invite.url': i.url ?? `https://discord.gg/${i.code}`, 'invite.inviter': i.inviter ? `<@${i.inviter.id}>` : '', 'invite.channel': i.channelId ? `<#${i.channelId}>` : '', 'invite.uses': i.uses ?? 0 });
const textCh = ch => ch?.isTextBased?.() && ch.send ? ch : null;

const has = (c, name) => (c.db.events || []).some(e => e.enabled !== false && e.event === name);
const NOMOD = { moderator: '', 'moderator.name': '', 'moderator.id': '', reason: '' };
// who did it (and why), read from the audit log. Needs the "View Audit Log" permission; returns null when not found.
async function audit(guild, type, targetId, pred = () => true) {
  try {
    await sleep(900);
    const logs = await guild.fetchAuditLogs({ type, limit: 8 });
    const e = logs.entries.find(x => x.targetId === targetId && Date.now() - x.createdTimestamp < 20000 && pred(x));
    if (!e) return null;
    const u = e.executor;
    return { reason: e.reason ?? '', map: { moderator: u ? `<@${u.id}>` : '', 'moderator.name': u?.username ?? '', 'moderator.id': u?.id ?? '', reason: e.reason ?? '' } };
  } catch { return null; }
}
// Discord sends no event when a timeout simply runs out, so a timer watches it
function watchTimeout(c, m) {
  const tm = (c.tmo ||= new Map()), k = m.guild.id + ':' + m.id;
  clearTimeout(tm.get(k));
  const ms = m.communicationDisabledUntilTimestamp - Date.now(); if (ms <= 0) return;
  tm.set(k, setTimeout(async () => {
    tm.delete(k);
    const f = await m.guild.members.fetch({ user: m.id, force: true }).catch(() => null); if (!f) return;
    const until = f.communicationDisabledUntilTimestamp || 0;
    if (until > Date.now() + 1500) return watchTimeout(c, f);          // extended, or the 24-day timer limit was hit
    fire(c, 'member_untimeout', { guild: f.guild, user: f.user, member: f, map: { ...mem(f.user, f, f.guild), ...NOMOD, 'timeout.ended': 'expired' } });
  }, Math.min(ms + 1500, 2 ** 31 - 1)));
}
const emj = e => ({ emoji: e.toString(), 'emoji.name': e.name ?? '', 'emoji.id': e.id, 'emoji.url': e.imageURL?.() ?? e.url ?? '' });

async function fire(client, name, o) {
  const list = (client.db.events || []).filter(e => e.enabled !== false && e.event === name);
  if (!list.length || !o.guild) return;
  if (SELF.includes(name) && o.user?.id === client.user.id) return;
  o.map ||= {};
  for (const c of list) {
    try {
      if (c.ignoreBots !== false && o.user?.bot) continue;
      const here = [o.channelId, o.channel?.id, o.channel?.parentId].filter(Boolean);
      const only = ids(c.onlyChannel); if (only.length && !only.some(x => here.includes(x))) continue;
      const roles = ids(c.onlyRole); if (roles.length && !o.member?.roles?.cache?.some(r => roles.includes(r.id))) continue;
      const kw = String(c.contains || '').split('\n').map(x => x.trim().toLowerCase()).filter(Boolean);
      if (kw.length && !kw.some(k => String(o.map['message.content'] || '').toLowerCase().includes(k))) continue;
      const em = String(c.emoji || '').split(/\s+/).filter(Boolean);
      if (em.length && !em.some(e => (o.emojis || []).includes(e))) continue;
      const tid = ids(c.channel)[0];
      let t = tid ? await client.channels.fetch(tid).catch(() => null) : null;
      t ||= textCh(o.channel); t ||= o.guild.systemChannel ?? null;
      const i = { ev: name, client, guild: o.guild, user: o.user || client.user, channelId: o.channelId ?? o.channel?.id ?? t?.id, channel: o.channel ?? t, target: t,
        evMap: o.map, message: o.message, memberPermissions: o.member?.permissions, vars: {} };
      runGraph(i, c, c.start?.next).catch(e => console.error(`[event "${c.name}"]`, e.message));
    } catch (e) { console.error(`[event "${c.name}"]`, e.message); }
  }
}

const reac = name => async (c, r, u) => {
  if (r.partial) r = await r.fetch().catch(() => r);
  if (r.message.partial) await r.message.fetch().catch(() => {});
  const m = r.message; if (!m.guild) return;
  if (u.partial) u = await u.fetch().catch(() => u);
  const member = await m.guild.members.fetch(u.id).catch(() => null);
  return fire(c, name, { guild: m.guild, user: u, member, channelId: m.channelId, channel: m.channel, message: m,
    emojis: [r.emoji.toString(), r.emoji.name, r.emoji.id].filter(Boolean),
    map: { ...mem(u, member, m.guild), ...msg(m), 'reaction.emoji': r.emoji.toString(), 'reaction.emoji.name': r.emoji.name ?? '', 'reaction.emoji.id': r.emoji.id ?? '', 'reaction.count': r.count ?? '' } });
};
const vc = ch => ({ 'voice.channel': ch ? `<#${ch.id}>` : '', 'voice.channel.id': ch?.id ?? '', 'voice.channel.name': ch?.name ?? '' });
const ban = (name, type) => async (c, b) => {
  if (b.partial) b = await b.fetch().catch(() => b);
  const a = has(c, name) ? await audit(b.guild, type, b.user.id) : null;
  return fire(c, name, { guild: b.guild, user: b.user, map: { ...mem(b.user, null, b.guild), ...(a?.map ?? NOMOD), 'ban.reason': b.reason ?? a?.reason ?? '' } });
};

// discord.js event name -> handler (client, ...args)
const LISTEN = {
  guildMemberAdd: (c, m) => fire(c, 'member_join', { guild: m.guild, user: m.user, member: m, map: mem(m.user, m, m.guild) }),
  async guildMemberRemove(c, m) {
    await fire(c, 'member_leave', { guild: m.guild, user: m.user, member: m, map: mem(m.user, m, m.guild) });
    if (!has(c, 'member_kick')) return;
    const a = await audit(m.guild, AuditLogEvent.MemberKick, m.id);
    if (a) await fire(c, 'member_kick', { guild: m.guild, user: m.user, member: m, map: { ...mem(m.user, m, m.guild), ...a.map } });
  },
  guildBanAdd: ban('member_ban', AuditLogEvent.MemberBanAdd),
  guildBanRemove: ban('member_unban', AuditLogEvent.MemberBanRemove),
  async guildMemberUpdate(c, o, n) {
    if (o.partial) return;
    const base = { guild: n.guild, user: n.user, member: n }, M = mem(n.user, n, n.guild);
    for (const [id, r] of n.roles.cache) if (!o.roles.cache.has(id)) await fire(c, 'member_role_add', { ...base, map: { ...M, ...rol(r) } });
    for (const [id, r] of o.roles.cache) if (!n.roles.cache.has(id)) await fire(c, 'member_role_remove', { ...base, map: { ...M, ...rol(r) } });
    if ((o.nickname || '') !== (n.nickname || '')) await fire(c, 'member_nickname', { ...base, map: { ...M, 'member.old.nickname': o.nickname || '', 'member.new.nickname': n.nickname || '' } });
    if (!o.premiumSince && n.premiumSince) await fire(c, 'member_boost', { ...base, map: { ...M, 'server.boosts': n.guild.premiumSubscriptionCount ?? '' } });
    const ot = o.communicationDisabledUntilTimestamp || 0, nt = n.communicationDisabledUntilTimestamp || 0, now = Date.now();
    const byTimeout = x => x.changes?.some(ch => ch.key === 'communication_disabled_until');
    if (nt > now && nt !== ot) {
      const a = has(c, 'member_timeout') ? await audit(n.guild, AuditLogEvent.MemberUpdate, n.id, byTimeout) : null;
      await fire(c, 'member_timeout', { ...base, map: { ...M, ...(a?.map ?? NOMOD), 'timeout.until': unix(nt), 'timeout.minutes': Math.max(Math.round((nt - now) / 60000), 1) } });
      if (has(c, 'member_untimeout')) watchTimeout(c, n);
    } else if (ot > now && nt <= now) {
      const tm = c.tmo, k = n.guild.id + ':' + n.id; if (tm) { clearTimeout(tm.get(k)); tm.delete(k); }
      const a = has(c, 'member_untimeout') ? await audit(n.guild, AuditLogEvent.MemberUpdate, n.id, byTimeout) : null;
      await fire(c, 'member_untimeout', { ...base, map: { ...M, ...(a?.map ?? NOMOD), 'timeout.ended': 'removed' } });
    }
  },
  presenceUpdate: (c, o, n) => n.guild && o?.status !== n.status && fire(c, 'presence_update', { guild: n.guild, user: n.user, member: n.member,
    map: { ...mem(n.user, n.member, n.guild), 'presence.old': o?.status ?? 'offline', 'presence.new': n.status } }),
  messageCreate: (c, m) => m.guild && fire(c, 'message_create', { guild: m.guild, user: m.author, member: m.member, channelId: m.channelId, channel: m.channel, message: m,
    map: { ...mem(m.author, m.member, m.guild), ...msg(m) } }),
  async messageUpdate(c, o, n) {
    if (n.partial) n = await n.fetch().catch(() => n);
    if (!n.guild || (o.content != null && o.content === n.content)) return;      // ignore embed-only updates
    return fire(c, 'message_edit', { guild: n.guild, user: n.author, member: n.member, channelId: n.channelId, channel: n.channel, message: n,
      map: { ...mem(n.author, n.member, n.guild), ...msg(n), 'message.old': o.content ?? '' } });
  },
  messageDelete: (c, m) => m.guild && fire(c, 'message_delete', { guild: m.guild, user: m.author, member: m.member, channelId: m.channelId, channel: m.channel, message: m,
    map: { ...mem(m.author, m.member, m.guild), ...msg(m) } }),
  async messageReactionAdd(c, r, u) {
    await reactTrigger(c, r, u).catch(e => console.error('[reaction trigger]', e.message));
    return reac('reaction_add')(c, r, u);
  },
  messageReactionRemove: reac('reaction_remove'),
  async voiceStateUpdate(c, o, n) {
    const base = { guild: n.guild, user: n.member?.user, member: n.member }, M = mem(base.user, n.member, n.guild);
    if (!o.channelId && n.channelId) return fire(c, 'voice_join', { ...base, channelId: n.channelId, channel: n.channel, map: { ...M, ...vc(n.channel) } });
    if (o.channelId && !n.channelId) return fire(c, 'voice_leave', { ...base, channelId: o.channelId, channel: o.channel, map: { ...M, ...vc(o.channel) } });
    if (o.channelId && n.channelId && o.channelId !== n.channelId)
      return fire(c, 'voice_move', { ...base, channelId: n.channelId, channel: n.channel, map: { ...M, ...vc(n.channel), 'voice.old': `<#${o.channelId}>`, 'voice.old.id': o.channelId, 'voice.old.name': o.channel?.name ?? '' } });
    if (o.channelId && o.channelId === n.channelId) {
      const V = { ...M, ...vc(n.channel), 'voice.self.muted': String(!!n.selfMute), 'voice.self.deafened': String(!!n.selfDeaf) }, e = { ...base, channelId: n.channelId, channel: n.channel };
      if (!!o.serverMute !== !!n.serverMute) await fire(c, 'voice_mute', { ...e, map: { ...V, 'voice.muted': String(!!n.serverMute) } });
      if (!!o.serverDeaf !== !!n.serverDeaf) await fire(c, 'voice_deafen', { ...e, map: { ...V, 'voice.deafened': String(!!n.serverDeaf) } });
    }
  },
  channelCreate: (c, ch) => ch.guild && fire(c, 'channel_create', { guild: ch.guild, channelId: ch.id, channel: textCh(ch), map: chn(ch) }),
  channelDelete: (c, ch) => ch.guild && fire(c, 'channel_delete', { guild: ch.guild, channelId: ch.id, map: chn(ch) }),
  channelUpdate: (c, o, n) => n.guild && fire(c, 'channel_update', { guild: n.guild, channelId: n.id, channel: textCh(n), map: { ...chn(n), 'channel.old.name': o.name ?? '' } }),
  roleCreate: (c, r) => fire(c, 'role_create', { guild: r.guild, map: rol(r) }),
  roleDelete: (c, r) => fire(c, 'role_delete', { guild: r.guild, map: rol(r) }),
  roleUpdate: (c, o, n) => fire(c, 'role_update', { guild: n.guild, map: { ...rol(n), 'role.old.name': o.name } }),
  async threadCreate(c, t, newly) {
    if (!newly || !t.guild) return;
    const user = t.ownerId ? await c.users.fetch(t.ownerId).catch(() => null) : null, member = t.ownerId ? await t.guild.members.fetch(t.ownerId).catch(() => null) : null;
    await t.join?.().catch(() => {});
    return fire(c, 'thread_create', { guild: t.guild, user, member, channelId: t.id, channel: t, map: { ...mem(user, member, t.guild), ...thr(t) } });
  },
  threadDelete: (c, t) => t.guild && fire(c, 'thread_delete', { guild: t.guild, channelId: t.parentId, channel: textCh(t.parent), map: thr(t) }),
  inviteCreate: (c, i) => i.guild && fire(c, 'invite_create', { guild: i.guild, user: i.inviter, channelId: i.channelId, channel: textCh(i.channel), map: { ...mem(i.inviter, null, i.guild), ...inv(i) } }),
  inviteDelete: (c, i) => i.guild && fire(c, 'invite_delete', { guild: i.guild, channelId: i.channelId, channel: textCh(i.channel), map: inv(i) }),
  guildCreate: (c, g) => fire(c, 'bot_join', { guild: g, map: {} }),
  messageDeleteBulk: (c, msgs, ch) => ch.guild && fire(c, 'message_bulk_delete', { guild: ch.guild, channelId: ch.id, channel: textCh(ch), map: { ...chn(ch), 'bulk.count': msgs.size } }),
  emojiCreate: (c, e) => fire(c, 'emoji_create', { guild: e.guild, map: emj(e) }),
  emojiDelete: (c, e) => fire(c, 'emoji_delete', { guild: e.guild, map: emj(e) })
};

async function start(db) {
  await stop(db.id);
  if (!db.settings.token) throw new Error('Enter the bot token');
  const I = db.settings.intents || {}, G = GatewayIntentBits;
  // non-privileged intents are always on so every event works; privileged ones come from Settings
  const intents = [G.Guilds, G.GuildMessages, G.GuildMessageReactions, G.GuildVoiceStates, G.GuildModeration, G.GuildInvites, G.DirectMessageReactions];
  const ex = G.GuildExpressions ?? G.GuildEmojisAndStickers; if (ex) intents.push(ex);
  if (I.members) intents.push(G.GuildMembers);
  if (I.presence) intents.push(G.GuildPresences);
  if (I.message) intents.push(G.MessageContent);
  const client = new Client({ intents, allowedMentions: { parse: ['users', 'roles'] }, partials: [Partials.Message, Partials.Channel, Partials.Reaction, Partials.User, Partials.GuildMember] });
  client.db = db;
  client.on('interactionCreate', onInt);
  for (const [ev, fn] of Object.entries(LISTEN)) client.on(ev, (...a) => Promise.resolve().then(() => fn(client, ...a)).catch(e => console.error(`[${ev}]`, e.message)));
  client.on('error', e => console.error('[client error]', e?.message || e));       // an unhandled 'error' event would kill the whole program
  client.on('shardError', e => console.error('[shard error]', e?.message || e));
  try {
    await withTimeout(client.login(db.settings.token), 30000, 'Discord did not answer the login in time. Try again.');
    if (!client.isReady()) await withTimeout(new Promise(r => client.once('ready', r)), 30000, 'The bot did not become ready in time. Try again.');
  } catch (e) {
    try { await client.destroy(); } catch {}
    throw new Error(/disallowed intents/i.test(e.message) ? 'Enable the same intents in the Discord Developer Portal (Bot → Privileged Gateway Intents) or turn them off here' : e.message);
  }
  clients.set(db.id, client);
  syncState.delete(db.id);
  presence(client, db.settings); refresh(db);       // commands sync in the background
}
